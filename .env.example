# Copy to .env and fill in. Never commit .env.

# --- Local model server (OpenAI-compatible endpoint) ---
# Model files location is set for Ollama itself (not here): setx OLLAMA_MODELS "F:\Ollama\models"
# See RUN_STEPS.md.
# Default: Ollama on this machine:
#   ollama pull qwen2.5vl:7b && ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# vLLM / LM Studio also work: just change LLM_BASE_URL (vLLM default: http://localhost:8000/v1)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama            # ignored by Ollama, but the openai client needs a value
VLM_MODEL=qwen2.5vl:7b        # DamageEvidenceAgent (use qwen2.5vl:3b on low VRAM)
LLM_MODEL=qwen2.5:7b          # IntakeAgent + PolicyRAG agent
EMBED_MODEL=nomic-embed-text  # policy clause retrieval (ollama pull nomic-embed-text)
RAG_TOP_K=6
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0

# --- Router hard gates (CLAUDE.md rules 4-5) ---
RISK_THRESHOLD=0.6
AUTO_APPROVE_PAYOUT_LIMIT=5000
MIN_DAMAGE_CONFIDENCE=0.7

# --- Storage ---
DATA_DIR=data/synthetic
AUDIT_DIR=data/audit
